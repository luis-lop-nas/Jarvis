# .env.example
# Copia este archivo a .env y rellena tus claves

# ============================================
# Groq API (RECOMENDADO - Respuestas rápidas)
# ============================================
# Consigue tu clave gratis en: https://console.groq.com/keys
GROQ_API_KEY=gsk_...tu-clave-groq-aqui...
GROQ_MODEL=llama-3.3-70b-versatile
USE_GROQ=true

# ============================================
# OpenAI API (Opcional - Alternativa a Groq)
# ============================================
OPENAI_API_KEY=sk-proj-...tu-clave-aqui...
OPENAI_MODEL=gpt-4
# OPENAI_ORG=org-...  # Opcional
# OPENAI_PROJECT=proj_...  # Opcional

# ============================================
# Ollama (Local - Opcional)
# ============================================
OLLAMA_MODEL=llama3.2:3b

# ============================================
# Porcupine (Wake Word) - Opcional
# Solo necesario si usas modo voz en terminal
# ============================================
# Consigue tu clave gratis en: https://console.picovoice.ai/
PORCUPINE_ACCESS_KEY=tu-clave-porcupine-aqui
WAKE_WORD=jarvis
WAKE_WORD_SENSITIVITY=0.5
WAKE_WORD_DEBUG=false
WAKE_WORD_MIN_RMS=120
WAKE_WORD_MIN_HITS=2
WAKE_WORD_COOLDOWN=1.5
WAKE_WORD_SCORE_EMA_ALPHA=0.6

# ============================================
# TTS — Engine de síntesis de voz
# ============================================
# Opciones: kokoro (default), piper, macos
TTS_ENGINE=kokoro

# ── Kokoro TTS (local, Apple Silicon, sin internet) ──────────────────────────
# Instalar: pip install ".[kokoro]"
# Los modelos se descargan automáticamente en primer uso (~300 MB).
#
# Voces disponibles:
#   Español : ef_dora (default), em_alex, em_santa
#   Inglés  : af_heart, af_bella, am_adam, am_michael
KOKORO_VOICE=ef_dora
KOKORO_SPEED=1.0
KOKORO_LANGUAGE=es

# ============================================
# Configuración general
# ============================================
DEBUG=false
DATA_DIR=data
# En macOS recientes, pynput puede provocar "trace trap" en algunos equipos.
# 0 = desactivar Ctrl+Space global y usar wake-word.
JARVIS_ENABLE_PYNPUT_HOTKEY=0

# ============================================
# Política central de confirmación (tools sensibles)
# ============================================
CONFIRM_POLICY_ENABLED=true
CONFIRM_TTL_SECONDS=120
# Lista opcional separada por comas para forzar confirmación por tool.
# Ejemplo: CONFIRM_ALWAYS_FOR=send_email,send_message
CONFIRM_ALWAYS_FOR=

# ============================================
# Dry-run por defecto para acciones sensibles
# ============================================
DRY_RUN_ENABLED=true
DRY_RUN_TTL_SECONDS=120
DRY_RUN_ALWAYS_FOR=send_email,send_message,calendar,filesystem,shell,web_agent
DRY_RUN_MAX_ITEMS_LIST=20
DRY_RUN_SNIPPET_CHARS=300

# ============================================
# Shell guard (allow | confirm | deny)
# ============================================
SHELL_GUARD_ENABLED=true
SHELL_GUARD_MODE=strict
# Overrides opcionales (regex separadas por comas)
SHELL_DENY_PATTERNS=
SHELL_CONFIRM_PATTERNS=

# ============================================
# Verifier post-acción
# ============================================
VERIFIER_ENABLED=true
VERIFIER_TIMEOUT_MS=1500
VERIFIER_MAX_ITEMS=50
VERIFIER_SAMPLE_IF_OVER=200
VERIFIER_STRICT=false

# ============================================
# Validación de schemas de tools (Pydantic)
# ============================================
TOOL_SCHEMA_VALIDATION_ENABLED=true
TOOL_SCHEMA_STRICT=true
TOOL_SCHEMA_LOG_INVALID=false

# ============================================
# Control por gestos (MediaPipe + cámara)
# Requiere: pip install ".[gestures]"
# ============================================
USE_GESTURES=false
GESTURE_COOLDOWN=1.5
GESTURE_DEBUG=false
GESTURE_CAMERA_INDEX=0

# ============================================
# Contexto de cámara (cara + objetos para contexto LLM)
# ============================================
CAMERA_CONTEXT=false
CAMERA_CONTEXT_INDEX=0
CAMERA_CONTEXT_INTERVAL=5.0
CAMERA_CONTEXT_FACE_ONLY=false

# ============================================
# PEV Pipeline (Planner → Executor → Verifier)
# ============================================
PEV_ENABLED=false
PEV_MAX_STEPS=6
PEV_RETRY_MAX=1
PEV_STATE_TTL_SECONDS=600
PEV_VERBOSE_TRACE=false
