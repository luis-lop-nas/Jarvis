<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>J.A.R.V.I.S - Advanced Interface</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <!-- Fondo animado con partículas -->
    <div class="background">
        <div class="gradient-orb orb-1"></div>
        <div class="gradient-orb orb-2"></div>
        <div class="gradient-orb orb-3"></div>
        <canvas id="particles"></canvas>
    </div>

    <!-- Menú Flotante -->
    <nav class="floating-menu" id="floatingMenu">
        <button class="menu-toggle" id="menuToggle">
            <span class="menu-line"></span>
            <span class="menu-line"></span>
            <span class="menu-line"></span>
        </button>
        
        <div class="menu-items" id="menuItems">
            <button class="menu-item" data-view="home">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
                <span>Home</span>
            </button>
            
            <button class="menu-item" data-view="chat">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
                <span>Chat</span>
            </button>
            
            <button class="menu-item" data-view="voice">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
                    <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                    <line x1="12" y1="19" x2="12" y2="23"></line>
                    <line x1="8" y1="23" x2="16" y2="23"></line>
                </svg>
                <span>Voice</span>
            </button>
            
            <button class="menu-item" data-view="tools">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
                </svg>
                <span>Tools</span>
            </button>
            
            <button class="menu-item" data-view="settings">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="3"></circle>
                    <path d="M12 1v6m0 6v6m6-13.5l-4.5 4.5m-3 3L6 13.5M1 12h6m6 0h6m-13.5 6l4.5-4.5m3-3l4.5-4.5"></path>
                </svg>
                <span>Settings</span>
            </button>
        </div>
    </nav>

    <!-- Container de Vistas con Transiciones -->
    <div class="views-container" id="viewsContainer">
        
        <!-- VISTA HOME: Orbe Principal -->
        <section class="view active" id="homeView">
            <div class="orb-container">
                <div class="jarvis-orb" id="jarvisOrb">
                    <!-- Núcleo del orbe -->
                    <div class="orb-core"></div>
                    
                    <!-- Anillos rotatorios -->
                    <div class="orb-ring ring-1"></div>
                    <div class="orb-ring ring-2"></div>
                    <div class="orb-ring ring-3"></div>
                    
                    <!-- Partículas flotantes -->
                    <div class="orb-particles">
                        <span class="particle"></span>
                        <span class="particle"></span>
                        <span class="particle"></span>
                        <span class="particle"></span>
                        <span class="particle"></span>
                        <span class="particle"></span>
                    </div>
                    
                    <!-- Glow externo -->
                    <div class="orb-glow"></div>
                </div>
                
                <h1 class="jarvis-title">J.A.R.V.I.S</h1>
                <p class="jarvis-subtitle">Just A Rather Very Intelligent System</p>
                <p class="jarvis-status" id="orbStatus">Listening...</p>
            </div>
        </section>

        <!-- VISTA CHAT -->
        <section class="view" id="chatView">
            <div class="view-header">
                <h2>Chat Interface</h2>
                <div class="status-badge">
                    <div class="status-dot"></div>
                    <span>Online</span>
                </div>
            </div>
            
            <div class="chat-area">
                <div class="messages-list" id="messagesList">
                    <div class="message assistant-message">
                        <div class="message-avatar">
                            <div class="mini-orb"></div>
                        </div>
                        <div class="message-bubble">
                            <p>Hola, soy J.A.R.V.I.S. ¿En qué puedo ayudarte?</p>
                            <span class="message-time">Ahora</span>
                        </div>
                    </div>
                </div>
                
                <div class="typing-indicator" id="typingIndicator">
                    <div class="mini-orb pulsing"></div>
                    <div class="typing-dots">
                        <span></span><span></span><span></span>
                    </div>
                </div>
            </div>
            
            <div class="chat-input-wrapper">
                <button class="voice-btn" id="voiceBtn">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
                        <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                        <line x1="12" y1="19" x2="12" y2="23"></line>
                        <line x1="8" y1="23" x2="16" y2="23"></line>
                    </svg>
                </button>
                <input type="text" id="chatInput" placeholder="Escribe tu mensaje..." autocomplete="off">
                <button class="send-btn" id="sendBtn">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="22" y1="2" x2="11" y2="13"></line>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                    </svg>
                </button>
            </div>
        </section>

        <!-- VISTA VOICE -->
        <section class="view" id="voiceView">
            <div class="view-header">
                <h2>Voice Assistant</h2>
            </div>
            
            <div class="voice-area">
                <div class="voice-orb-wrapper">
                    <div class="voice-orb" id="voiceOrb">
                        <div class="orb-core"></div>
                        <div class="orb-ring ring-1"></div>
                        <div class="orb-ring ring-2"></div>
                        <canvas id="audioVisualizer"></canvas>
                    </div>
                </div>
                
                <p class="voice-status" id="voiceStatus">Toca el orbe para hablar</p>
                
                <div class="voice-controls">
                    <button class="control-btn" id="voiceStartBtn">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
                            <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                            <line x1="12" y1="19" x2="12" y2="23"></line>
                            <line x1="8" y1="23" x2="16" y2="23"></line>
                        </svg>
                        <span>Activar Voz</span>
                    </button>
                </div>
            </div>
        </section>

        <!-- VISTA TOOLS -->
        <section class="view" id="toolsView">
            <div class="view-header">
                <h2>Available Tools</h2>
            </div>
            
            <div class="tools-grid">
                <div class="tool-card">
                    <div class="tool-icon">🔍</div>
                    <h3>Web Search</h3>
                    <p>Buscar información en la web</p>
                </div>
                
                <div class="tool-card">
                    <div class="tool-icon">💻</div>
                    <h3>Code Execution</h3>
                    <p>Ejecutar código de forma segura</p>
                </div>
                
                <div class="tool-card">
                    <div class="tool-icon">📁</div>
                    <h3>Filesystem</h3>
                    <p>Gestionar archivos y directorios</p>
                </div>
                
                <div class="tool-card">
                    <div class="tool-icon">🎵</div>
                    <h3>Spotify</h3>
                    <p>Control de reproducción musical</p>
                </div>
                
                <div class="tool-card">
                    <div class="tool-icon">📧</div>
                    <h3>Email</h3>
                    <p>Enviar y gestionar correos</p>
                </div>
                
                <div class="tool-card">
                    <div class="tool-icon">📅</div>
                    <h3>Calendar</h3>
                    <p>Gestión de eventos y recordatorios</p>
                </div>
            </div>
        </section>

        <!-- VISTA SETTINGS -->
        <section class="view" id="settingsView">
            <div class="view-header">
                <h2>Settings</h2>
            </div>
            
            <div class="settings-container">
                <div class="setting-group">
                    <h3>Apariencia</h3>
                    <div class="setting-item">
                        <label>Tema</label>
                        <select class="setting-select">
                            <option>Oscuro</option>
                            <option>Claro</option>
                            <option>Auto</option>
                        </select>
                    </div>
                    
                    <div class="setting-item">
                        <label>Color Principal</label>
                        <div class="color-picker">
                            <button class="color-option active" data-color="#00d4ff" style="background: #00d4ff"></button>
                            <button class="color-option" data-color="#ff0000" style="background: #ff0000"></button>
                            <button class="color-option" data-color="#00ff00" style="background: #00ff00"></button>
                            <button class="color-option" data-color="#ff00ff" style="background: #ff00ff"></button>
                        </div>
                    </div>
                </div>
                
                <div class="setting-group">
                    <h3>Voz</h3>
                    <div class="setting-item">
                        <label>Wake Word</label>
                        <input type="text" class="setting-input" value="Hey Jarvis" readonly>
                    </div>
                    
                    <div class="setting-item">
                        <label>Idioma</label>
                        <select class="setting-select">
                            <option>Español</option>
                            <option>English</option>
                            <option>Français</option>
                        </select>
                    </div>
                </div>
            </div>
        </section>

    </div>

    <script src="app.js"></script>
</body>
</html>
