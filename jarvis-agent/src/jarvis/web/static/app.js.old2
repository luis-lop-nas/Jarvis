// =========================================
// VARIABLES GLOBALES
// =========================================

let currentView = 'home';
let ws = null;
let isConnected = false;
let reconnectTimeout = null;

// Referencias DOM
const menuToggle = document.getElementById('menuToggle');
const menuItems = document.getElementById('menuItems');
const jarvisOrb = document.getElementById('jarvisOrb');
const orbStatus = document.getElementById('orbStatus');
const particlesCanvas = document.getElementById('particles');
const chatInput = document.getElementById('chatInput');
const sendBtn = document.getElementById('sendBtn');
const voiceBtn = document.getElementById('voiceBtn');
const messagesList = document.getElementById('messagesList');
const typingIndicator = document.getElementById('typingIndicator');

// Estados del orbe
const ORB_STATES = {
    IDLE: 'idle',
    LISTENING: 'listening',
    THINKING: 'thinking',
    SPEAKING: 'speaking'
};

let currentOrbState = ORB_STATES.IDLE;

// =========================================
// INICIALIZACIÓN
// =========================================

document.addEventListener('DOMContentLoaded', () => {
    initializeApp();
    initializeParticles();
    setupEventListeners();
    connect();
});

function initializeApp() {
    console.log('🚀 J.A.R.V.I.S. Advanced UI iniciado');
    
    const homeView = document.getElementById('homeView');
    if (homeView) {
        homeView.classList.add('active');
    }
    
    const homeMenuItem = document.querySelector('[data-view="home"]');
    if (homeMenuItem) {
        homeMenuItem.classList.add('active');
    }
}

// =========================================
// PARTÍCULAS DE FONDO
// =========================================

function initializeParticles() {
    if (!particlesCanvas) return;
    
    const ctx = particlesCanvas.getContext('2d');
    particlesCanvas.width = window.innerWidth;
    particlesCanvas.height = window.innerHeight;
    
    const particles = [];
    const particleCount = 50;
    
    class Particle {
        constructor() {
            this.x = Math.random() * particlesCanvas.width;
            this.y = Math.random() * particlesCanvas.height;
            this.vx = (Math.random() - 0.5) * 0.5;
            this.vy = (Math.random() - 0.5) * 0.5;
            this.size = Math.random() * 2 + 1;
            this.opacity = Math.random() * 0.5 + 0.2;
        }
        
        update() {
            this.x += this.vx;
            this.y += this.vy;
            
            if (this.x < 0 || this.x > particlesCanvas.width) this.vx *= -1;
            if (this.y < 0 || this.y > particlesCanvas.height) this.vy *= -1;
        }
        
        draw() {
            ctx.beginPath();
            ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(0, 212, 255, ${this.opacity})`;
            ctx.fill();
        }
    }
    
    for (let i = 0; i < particleCount; i++) {
        particles.push(new Particle());
    }
    
    function animateParticles() {
        ctx.clearRect(0, 0, particlesCanvas.width, particlesCanvas.height);
        
        particles.forEach(particle => {
            particle.update();
            particle.draw();
        });
        
        requestAnimationFrame(animateParticles);
    }
    
    animateParticles();
    
    window.addEventListener('resize', () => {
        particlesCanvas.width = window.innerWidth;
        particlesCanvas.height = window.innerHeight;
    });
}

// =========================================
// EVENT LISTENERS
// =========================================

function setupEventListeners() {
    menuToggle.addEventListener('click', () => {
        menuToggle.classList.toggle('active');
        menuItems.classList.toggle('active');
    });
    
    document.addEventListener('click', (e) => {
        if (!menuToggle.contains(e.target) && !menuItems.contains(e.target)) {
            menuToggle.classList.remove('active');
            menuItems.classList.remove('active');
        }
    });
    
    const menuItemButtons = document.querySelectorAll('.menu-item');
    menuItemButtons.forEach(item => {
        item.addEventListener('click', () => {
            const view = item.getAttribute('data-view');
            navigateToView(view);
            
            menuToggle.classList.remove('active');
            menuItems.classList.remove('active');
            
            menuItemButtons.forEach(btn => btn.classList.remove('active'));
            item.classList.add('active');
        });
    });
    
    if (jarvisOrb) {
        jarvisOrb.addEventListener('click', () => {
            toggleOrbState();
        });
    }
    
    if (chatInput) {
        chatInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendMessage();
            }
        });
    }
    
    if (sendBtn) {
        sendBtn.addEventListener('click', sendMessage);
    }
    
    if (voiceBtn) {
        voiceBtn.addEventListener('mousedown', startVoiceRecording);
        voiceBtn.addEventListener('mouseup', stopVoiceRecording);
        voiceBtn.addEventListener('touchstart', startVoiceRecording);
        voiceBtn.addEventListener('touchend', stopVoiceRecording);
    }
    
    const colorOptions = document.querySelectorAll('.color-option');
    colorOptions.forEach(option => {
        option.addEventListener('click', () => {
            const color = option.getAttribute('data-color');
            changeThemeColor(color);
            
            colorOptions.forEach(opt => opt.classList.remove('active'));
            option.classList.add('active');
        });
    });
}

// =========================================
// NAVEGACIÓN ENTRE VISTAS
// =========================================

function navigateToView(viewName) {
    if (currentView === viewName) return;
    
    console.log(`📱 Navegando a: ${viewName}`);
    
    const currentViewEl = document.getElementById(`${currentView}View`);
    const newViewEl = document.getElementById(`${viewName}View`);
    
    if (!newViewEl) {
        console.error(`Vista no encontrada: ${viewName}View`);
        return;
    }
    
    if (currentViewEl) {
        currentViewEl.classList.add('exit-left');
        currentViewEl.classList.remove('active');
    }
    
    setTimeout(() => {
        newViewEl.classList.remove('exit-left');
        newViewEl.classList.add('active');
        
        if (currentViewEl) {
            currentViewEl.classList.remove('exit-left');
        }
        
        currentView = viewName;
        onViewEnter(viewName);
    }, 100);
}

function onViewEnter(viewName) {
    switch (viewName) {
        case 'home':
            setOrbState(ORB_STATES.IDLE);
            break;
        case 'chat':
            if (chatInput) chatInput.focus();
            break;
        case 'voice':
            initializeVoiceView();
            break;
        default:
            break;
    }
}

// =========================================
// ESTADOS DEL ORBE
// =========================================

function setOrbState(state) {
    Object.values(ORB_STATES).forEach(s => {
        jarvisOrb.classList.remove(s);
    });
    
    jarvisOrb.classList.add(state);
    currentOrbState = state;
    
    updateOrbStatusText(state);
}

function updateOrbStatusText(state) {
    if (!orbStatus) return;
    
    const statusTexts = {
        [ORB_STATES.IDLE]: 'Listening...',
        [ORB_STATES.LISTENING]: 'I\'m listening...',
        [ORB_STATES.THINKING]: 'Thinking...',
        [ORB_STATES.SPEAKING]: 'Speaking...'
    };
    
    orbStatus.textContent = statusTexts[state] || 'Ready';
}

function toggleOrbState() {
    const states = [ORB_STATES.IDLE, ORB_STATES.LISTENING, ORB_STATES.THINKING, ORB_STATES.SPEAKING];
    const currentIndex = states.indexOf(currentOrbState);
    const nextIndex = (currentIndex + 1) % states.length;
    
    setOrbState(states[nextIndex]);
}

// =========================================
// WEBSOCKET
// =========================================

function connect() {
    const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
    const wsUrl = `${protocol}//${window.location.host}/ws`;
    
    console.log('🔌 Conectando WebSocket:', wsUrl);
    
    try {
        ws = new WebSocket(wsUrl);
        
        ws.onopen = () => {
            isConnected = true;
            console.log('✅ WebSocket conectado');
            
            if (reconnectTimeout) {
                clearTimeout(reconnectTimeout);
                reconnectTimeout = null;
            }
        };
        
        ws.onclose = () => {
            isConnected = false;
            console.log('🔌 WebSocket desconectado');
            scheduleReconnect();
        };
        
        ws.onerror = (error) => {
            console.error('❌ WebSocket error:', error);
        };
        
        ws.onmessage = (event) => {
            handleWebSocketMessage(event);
        };
        
    } catch (error) {
        console.error('❌ Error creando WebSocket:', error);
        scheduleReconnect();
    }
}

function scheduleReconnect() {
    if (reconnectTimeout) return;
    
    console.log('🔄 Reconectando en 3 segundos...');
    reconnectTimeout = setTimeout(() => {
        reconnectTimeout = null;
        connect();
    }, 3000);
}

function handleWebSocketMessage(event) {
    try {
        const data = JSON.parse(event.data);
        console.log('📨 Mensaje recibido:', data);
        
        switch (data.type) {
            case 'assistant_message':
                hideTypingIndicator();
                addAssistantMessage(data.content);
                setOrbState(ORB_STATES.SPEAKING);
                
                setTimeout(() => {
                    setOrbState(ORB_STATES.IDLE);
                }, 3000);
                break;
                
            case 'error':
                hideTypingIndicator();
                addSystemMessage(data.content);
                break;
                
            default:
                console.log('Tipo de mensaje desconocido:', data.type);
        }
    } catch (error) {
        console.error('❌ Error procesando mensaje:', error);
    }
}

// =========================================
// CHAT
// =========================================

function sendMessage() {
    const message = chatInput.value.trim();
    
    if (!message) return;
    
    addUserMessage(message);
    
    chatInput.value = '';
    chatInput.focus();
    
    showTypingIndicator();
    
    setOrbState(ORB_STATES.THINKING);
    
    if (isConnected && ws) {
        try {
            ws.send(JSON.stringify({
                message: message
            }));
        } catch (error) {
            console.error('❌ Error enviando mensaje:', error);
            hideTypingIndicator();
            addSystemMessage('Error al enviar mensaje');
        }
    } else {
        setTimeout(() => {
            hideTypingIndicator();
            addAssistantMessage('Esta es una respuesta de demostración. Conecta el backend para funcionalidad completa.');
            setOrbState(ORB_STATES.SPEAKING);
            setTimeout(() => setOrbState(ORB_STATES.IDLE), 3000);
        }, 1000);
    }
}

function addUserMessage(content) {
    const messageEl = document.createElement('div');
    messageEl.className = 'message user-message';
    messageEl.innerHTML = `
        <div class="message-bubble">
            <p>${escapeHtml(content)}</p>
            <span class="message-time">${getCurrentTime()}</span>
        </div>
    `;
    
    messagesList.appendChild(messageEl);
    scrollToBottom(messagesList.parentElement);
}

function addAssistantMessage(content) {
    const messageEl = document.createElement('div');
    messageEl.className = 'message assistant-message';
    messageEl.innerHTML = `
        <div class="message-avatar">
            <div class="mini-orb"></div>
        </div>
        <div class="message-bubble">
            <p>${escapeHtml(content)}</p>
            <span class="message-time">${getCurrentTime()}</span>
        </div>
    `;
    
    messagesList.appendChild(messageEl);
    scrollToBottom(messagesList.parentElement);
}

function addSystemMessage(content) {
    const messageEl = document.createElement('div');
    messageEl.style.cssText = 'text-align: center; padding: 1rem; color: var(--text-muted); font-size: 0.9rem;';
    messageEl.textContent = content;
    
    messagesList.appendChild(messageEl);
    scrollToBottom(messagesList.parentElement);
}

function showTypingIndicator() {
    if (typingIndicator) {
        typingIndicator.classList.add('active');
        scrollToBottom(messagesList.parentElement);
    }
}

function hideTypingIndicator() {
    if (typingIndicator) {
        typingIndicator.classList.remove('active');
    }
}

// =========================================
// VOZ
// =========================================

let mediaRecorder = null;
let audioChunks = [];
let isRecording = false;

function initializeVoiceView() {
    const voiceOrb = document.getElementById('voiceOrb');
    const voiceStartBtn = document.getElementById('voiceStartBtn');
    
    if (voiceOrb) {
        voiceOrb.addEventListener('click', () => {
            if (!isRecording) {
                startVoiceRecording();
            } else {
                stopVoiceRecording();
            }
        });
    }
    
    if (voiceStartBtn) {
        voiceStartBtn.addEventListener('click', () => {
            if (!isRecording) {
                startVoiceRecording();
            } else {
                stopVoiceRecording();
            }
        });
    }
}

async function startVoiceRecording() {
    try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        
        mediaRecorder = new MediaRecorder(stream);
        audioChunks = [];
        
        mediaRecorder.ondataavailable = (event) => {
            audioChunks.push(event.data);
        };
        
        mediaRecorder.onstop = async () => {
            const audioBlob = new Blob(audioChunks, { type: 'audio/wav' });
            await sendAudioToServer(audioBlob);
            
            stream.getTracks().forEach(track => track.stop());
        };
        
        mediaRecorder.start();
        isRecording = true;
        
        setOrbState(ORB_STATES.LISTENING);
        updateVoiceStatus('🎤 Grabando...');
        
        if (voiceBtn) voiceBtn.classList.add('recording');
        
    } catch (error) {
        console.error('❌ Error accediendo al micrófono:', error);
        updateVoiceStatus('Error: No se pudo acceder al micrófono');
    }
}

function stopVoiceRecording() {
    if (mediaRecorder && isRecording) {
        mediaRecorder.stop();
        isRecording = false;
        
        setOrbState(ORB_STATES.THINKING);
        updateVoiceStatus('Procesando audio...');
        
        if (voiceBtn) voiceBtn.classList.remove('recording');
    }
}

async function sendAudioToServer(audioBlob) {
    console.log('🎤 Audio capturado:', audioBlob.size, 'bytes');
    
    setTimeout(() => {
        setOrbState(ORB_STATES.IDLE);
        updateVoiceStatus('Audio procesado (demo mode)');
    }, 2000);
}

function updateVoiceStatus(status) {
    const voiceStatus = document.getElementById('voiceStatus');
    if (voiceStatus) {
        voiceStatus.textContent = status;
    }
}

// =========================================
// SETTINGS
// =========================================

function changeThemeColor(color) {
    document.documentElement.style.setProperty('--primary-color', color);
    
    const hsl = hexToHSL(color);
    const darker = `hsl(${hsl.h}, ${hsl.s}%, ${Math.max(hsl.l - 20, 0)}%)`;
    const lighter = `hsl(${hsl.h}, ${hsl.s}%, ${Math.min(hsl.l + 20, 100)}%)`;
    
    document.documentElement.style.setProperty('--primary-dark', darker);
    document.documentElement.style.setProperty('--primary-light', lighter);
    
    console.log('🎨 Color cambiado a:', color);
}

// =========================================
// UTILIDADES
// =========================================

function scrollToBottom(element) {
    if (!element) return;
    requestAnimationFrame(() => {
        element.scrollTop = element.scrollHeight;
    });
}

function getCurrentTime() {
    const now = new Date();
    const hours = String(now.getHours()).padStart(2, '0');
    const minutes = String(now.getMinutes()).padStart(2, '0');
    return `${hours}:${minutes}`;
}

function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

function hexToHSL(hex) {
    const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
    if (!result) return { h: 0, s: 0, l: 0 };
    
    let r = parseInt(result[1], 16) / 255;
    let g = parseInt(result[2], 16) / 255;
    let b = parseInt(result[3], 16) / 255;
    
    const max = Math.max(r, g, b);
    const min = Math.min(r, g, b);
    let h, s, l = (max + min) / 2;
    
    if (max === min) {
        h = s = 0;
    } else {
        const d = max - min;
        s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
        
        switch (max) {
            case r: h = (g - b) / d + (g < b ? 6 : 0); break;
            case g: h = (b - r) / d + 2; break;
            case b: h = (r - g) / d + 4; break;
        }
        
        h /= 6;
    }
    
    return {
        h: Math.round(h * 360),
        s: Math.round(s * 100),
        l: Math.round(l * 100)
    };
}

document.addEventListener('visibilitychange', () => {
    if (!document.hidden && !isConnected) {
        console.log('📱 Página visible, reconectando...');
        connect();
    }
});

window.addEventListener('beforeunload', () => {
    if (ws && isConnected) {
        ws.close();
    }
});

console.log('✨ J.A.R.V.I.S. Advanced UI - Todos los sistemas operativos');
